$("m1Calculate").addEventListener("click",()=>{
  const total = readInteger("m1Total",1,100000000);
  const a = readInteger("m1A",0,100000000);
  const b = readInteger("m1B",0,100000000);

  if([total,a,b].some(v=>v===null)){
    showResult(
      "m1Result",
      "<strong>Periksa kembali angka.</strong><p>Isi semua kolom dengan bilangan bulat yang valid.</p>"
    );
    return;
