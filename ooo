const labPAInput = document.getElementById("pA");
const labFeedback = document.getElementById("feedback");
const labPreviousButton = document.getElementById("previousMission");
const labNextButton = document.getElementById("nextMission");

let labMissionId = 1;
let labOutcomes = [];
let labObserved = new Set();
let labRollingKeys = new Set();
let labDisplayedResults = new Map();

function labKeyOf(outcome){ return outcome.join("-"); }
function labLabelOf(outcome){ return outcome.length===1 ? String(outcome[0]) : `(${outcome[0]}, ${outcome[1]})`; }

function labMakeOutcomes(){
  labOutcomes = [];
  const n = labMissions[labMissionId].dice;
  if(n===1){ for(let a=1;a<=6;a++) labOutcomes.push([a]); }
  else{ for(let a=1;a<=6;a++) for(let b=1;b<=6;b++) labOutcomes.push([a,b]); }
  labDisplayedResults.clear();
  labOutcomes.forEach(o=>{ labDisplayedResults.set(labKeyOf(o), o.map(()=>1)); });
}

function labMakeFace(faceName, number){
  const face = document.createElement("div");
  face.className = `face ${faceName}`;
  face.dataset.number = number;
  for(let i=0;i<number;i++){
    const pip = document.createElement("span");
    pip.className = "pip";
    face.appendChild(pip);
  }
  return face;
}

const labFaceDefinitions = [["front",1],["back",6],["right",3],["left",4],["top",5],["bottom",2]];

function labMakeDie(number, uniqueId){
  const stage = document.createElement("div");
  stage.className = "die-stage";
  const cube = document.createElement("div");
  cube.className = "die-cube";
  cube.id = uniqueId;
  labFaceDefinitions.forEach(([faceName, defaultNumber])=>{
    const faceNumber = faceName === "front" ? number : defaultNumber;
    cube.appendChild(labMakeFace(faceName, faceNumber));
  });
  cube.style.transform = "rotateX(0deg) rotateY(0deg)";
  stage.appendChild(cube);
  return stage;
}

function labCreateCard(outcome){
  const key = labKeyOf(outcome);
  const isObserved = labObserved.has(key);
  const isRolling = labRollingKeys.has(key);
  const savedFaces = labDisplayedResults.get(key) || outcome.map(()=>1);
  const card = document.createElement("div");
  card.className = "dice-card";
  const pair = document.createElement("div");
  pair.className = "dice-pair";
  pair.appendChild(labMakeDie(savedFaces[0], `die-${key}-a`));
  if(outcome.length===2){ pair.appendChild(labMakeDie(savedFaces[1], `die-${key}-b`)); }
  const status = document.createElement("div");
  status.className = "card-status";
  if(isRolling){ status.textContent = "Dadu sedang dikocok..."; }
  else if(isObserved){ status.textContent = `Hasil: ${savedFaces.join(" dan ")}`; }
  else{ status.textContent = "Belum dikocok"; }
  const button = document.createElement("button");
  button.className = isObserved ? "secondary" : "primary";
  button.textContent = isObserved ? "Kocok Lagi" : "Kocok";
  button.disabled = labRollingKeys.size > 0;
  button.addEventListener("click", ()=>{ labRollCard(outcome); });
  card.appendChild(pair);
  card.appendChild(status);
  card.appendChild(button);
  return card;
}

