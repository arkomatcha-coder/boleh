let coinResults=[];

function flipCoin(amount){
  for(let i=0;i<amount;i++){ coinResults.push(Math.random()<0.5?'A':'G'); }
  updateCoin();
}

function updateCoin(){
  const total=coinResults.length;
  const heads=coinResults.filter(x=>x==='A').length;
  const tails=coinResults.filter(x=>x==='G').length;
  document.getElementById('coinTotal').textContent=total;
  document.getElementById('headsTotal').textContent=heads;
  document.getElementById('tailsTotal').textContent=tails;
  document.getElementById('headsRelative').textContent=total?`heads/{total} = ${(heads/total).toFixed(2)}`:'0/0 = 0';
  document.getElementById('tailsRelative').textContent=total?`tails/{total} = ${(tails/total).toFixed(2)}`:'0/0 = 0';
  const coin=document.getElementById('coinVisual');
  const caption=document.getElementById('coinCaption');
  if(total){
    const lastResult=coinResults[total-1];
    coin.textContent=lastResult;
    caption.textContent=lastResult==='A'?'Sisi Angka (A) muncul':'Sisi Gambar (G) muncul';
    coin.classList.remove('flipping');
    void coin.offsetWidth;
    coin.classList.add('flipping');
  }else{
    coin.textContent='K';
    caption.textContent='Koin siap dilempar';
    coin.classList.remove('flipping');
  }
  document.getElementById('coinHistory').textContent=
    total?coinResults.map((x,i)=>`${i+1}. ${x==='A'?'Angka':'Gambar'}`).join(' | '):'Belum ada percobaan.';
}

function resetCoin(){ coinResults=[]; updateCoin(); }

function updateEventProbability(){
  const total=Number(document.getElementById('eventTotal').value);
  const favorable=Number(document.getElementById('eventFavorable').value);
  const slider=document.getElementById('eventFavorable');
  slider.max=total;
  const valid=Math.min(favorable,total);
  slider.value=valid;
  document.getElementById('eventTotalValue').textContent=total;
  document.getElementById('eventFavorableValue').textContent=valid;
  const probability=valid/total;
  document.getElementById('eventNTotal').textContent=total;
  document.getElementById('eventNFavorable').textContent=valid;
  document.getElementById('eventProbability').textContent=probability.toFixed(2).replace('.',',');
  document.getElementById('eventFormula').textContent=`P(A) = valid/{total} = ${probability.toFixed(2).replace('.',',')}`;
  let visual='';
  for(let i=0;i<total;i++){ visual+=`<div class="number-item i<valid?'selected':''">{i<valid?'A':'-'}</div>`; }
  document.getElementById('eventBallVisual').innerHTML=visual;
  document.getElementById('eventExplanation').textContent=
    `Terdapat ${valid} bola yang termasuk kejadian A dari ${total} bola seluruhnya. Peluang kejadian A adalah valid/{total} = ${probability.toFixed(2).replace('.',',')}.`;
}

function updateComplement(){
  const total=Number(document.getElementById('complementTotal').value);
  const favorable=Number(document.getElementById('complementFavorable').value);
  const slider=document.getElementById('complementFavorable');
  slider.max=total;
  const valid=Math.min(favorable,total);
  slider.value=valid;
  const complement=total-valid;
  const pA=valid/total;
  const pAc=complement/total;
  document.getElementById('complementTotalValue').textContent=total;
  document.getElementById('complementFavorableValue').textContent=valid;
  document.getElementById('probA').textContent=pA.toFixed(2).replace('.',',');
  document.getElementById('probComplement').textContent=pAc.toFixed(2).replace('.',',');
  document.getElementById('complementFormula').textContent=`P(Aᶜ) = 1 − ${pA.toFixed(2).replace('.',',')} = ${pAc.toFixed(2).replace('.',',')}`;
  let visual='';
  for(let i=0;i<total;i++){ visual+=`<div class="number-item i<valid?'selected':''">{i<valid?'A':'Aᶜ'}</div>`; }
  document.getElementById('complementBallVisual').innerHTML=visual;
  document.getElementById('complementExplanation').textContent=
    `Dari ${total} bola, ${valid} bola termasuk kejadian A dan ${complement} bola termasuk komplemen A. Jadi P(A) = valid/{total} dan P(Aᶜ) = complement/{total}. Jumlah kedua peluang tersebut selalu sama dengan 1.`;
}

function calculateExpectedFrequency(){
  const n=Number(document.getElementById('fhN').value);
  const p=Number(document.getElementById('fhP').value);
  const result=document.getElementById('expectedResult');
  result.style.display = 'block';
  if(!Number.isFinite(n)||!Number.isFinite(p)||n<=0||p<0||p>1){
    result.textContent='Masukkan banyak percobaan lebih dari 0 dan peluang antara 0 sampai 1.';
    return;
  }
  const fh=n*p;
  result.innerHTML=`Fh(A) = P(A) × n<br>= ${p} × ${n}<br><strong>= ${fh}</strong><br>Jadi, frekuensi harapan adalah ${fh}.`;
}

