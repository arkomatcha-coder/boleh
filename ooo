function fraction(n,d){
  if(d === 0) return "tidak terdefinisi";
  if(n === 0) return "0";
  if(n === d) return "1";
  const gcd = (a,b) => b === 0 ? a : gcd(b,a%b);
  const g = gcd(Math.abs(n),Math.abs(d));
  return `n/g/{d/g}`;
}

