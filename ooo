    const numberCell = document.createElement("td");
    numberCell.textContent = labObservationBody.children.length + 1;
    const resultCell = document.createElement("td");
    resultCell.textContent = labLabelOf(outcome);
    const eventCell = document.createElement("td");
    eventCell.textContent = isEvent ? "Termasuk kejadian" : "Bukan kejadian";
    const statusCell = document.createElement("td");
    statusCell.textContent = "Sudah diamati";
    row.append(numberCell, resultCell, eventCell, statusCell);
    labObservationBody.appendChild(row);
  });
  if(labObserved.size === 0){
    labObservationBody.innerHTML = `<tr><td colspan="4">Belum ada hasil pengamatan.</td></tr>`;
  }
  labUpdateStatistics();
}

function labUpdateStatistics(){
  labSampleCount.textContent = labOutcomes.length;
  labObservedCount.textContent = labObserved.size;
  labRemainingCount.textContent = labOutcomes.length - labObserved.size;
  const allObserved = labObserved.size === labOutcomes.length;
  labAnswerArea.style.display = allObserved ? "block" : "none";
  labPreviousButton.disabled = !allObserved || labMissionId === 1;
  labNextButton.disabled = !allObserved || labMissionId === 9;
}

function labRenderAll(){ labRenderGrid(); labRenderTable(); }

function labRollCard(outcome){
  if(labRollingKeys.size > 0) return;
  const key = labKeyOf(outcome);
  labRollingKeys.add(key);
  labRenderGrid();
  const cubeA = document.getElementById(`die-${key}-a`);
  const cubeB = outcome.length === 2 ? document.getElementById(`die-${key}-b`) : null;
  const cubes = [cubeA, cubeB].filter(Boolean);
  const animationTimer = setInterval(()=>{
    cubes.forEach(cube=>{
      cube.style.transform = `rotateX(Math.random()*720deg)rotateY({Math.random()*720}deg)`;
    });
  }, 90);
  setTimeout(()=>{
    clearInterval(animationTimer);
    labDisplayedResults.set(key, [...outcome]);
    labObserved.add(key);
    labRollingKeys.delete(key);
    labRenderAll();
  }, 1500);
}

function labRollNext(){
  if(labRollingKeys.size > 0) return;
  const nextOutcome = labOutcomes.find(o => !labObserved.has(labKeyOf(o)));
  if(nextOutcome){ labRollCard(nextOutcome); }
  else{ alert("Semua kemungkinan hasil sudah diamati."); }
}

function labResetMission(){
  if(labRollingKeys.size > 0) return;
  labObserved.clear();
  labNAInput.value = "";
  labPAInput.value = "";
  labFeedback.textContent = "";
  labDisplayedResults.clear();
  labOutcomes.forEach(o=>{ labDisplayedResults.set(labKeyOf(o), o.map(()=>1)); });
  labRenderAll();
}

function labSetupMission(){
  labMissionId = Number(labMissionSelect.value);
  labObserved.clear();
  labRollingKeys.clear();
  const mission = labMissions[labMissionId];
  document.getElementById("missionDescription").textContent = mission.description;
  document.getElementById("diceDescription").textContent = mission.dice === 1 ? "Pada misi ini terdapat 6 kemungkinan hasil dari satu dadu." : "Pada misi ini terdapat 36 kemungkinan hasil dari dua dadu.";
  labNAInput.value = "";
  labPAInput.value = "";
  labFeedback.textContent = "";
  labMakeOutcomes();
  labRenderAll();
}

function labNavigateMission(nextId){
  if(labRollingKeys.size > 0) return;
  if(nextId < 1 || nextId > 9) return;
  if(labObserved.size !== labOutcomes.length) return;
  labMissionSelect.value = String(nextId);
  labSetupMission();
  window.scrollTo({top:0, behavior:"smooth"});
}

function labCheckAnswers(){
  const nText = labNAInput.value.trim();
  const pText = labPAInput.value.trim();
  if(nText === "" || pText === ""){
    labFeedback.textContent = "Silakan lengkapi kedua jawaban terlebih dahulu.";
    labFeedback.style.color = "#b45309";
    return;
  }
  const nAnswer = Number(nText);
  const normalized = pText.replace(",", ".");
  let pAnswer;
  if(normalized.includes("/")){
    const parts = normalized.split("/");
    if(parts.length !== 2 || parts.some(p=>p.trim()==="") || !Number.isFinite(Number(parts[0])) || !Number.isFinite(Number(parts[1])) || Number(parts[1]) === 0){
      labFeedback.textContent = "Format pecahan belum tepat.";
      labFeedback.style.color = "#b45309";
      return;
    }
    pAnswer = Number(parts[0]) / Number(parts[1]);
  }else{
    pAnswer = Number(normalized);
    if(pAnswer > 1 && pAnswer <= 100){ pAnswer = pAnswer / 100; }
  }
  const mission = labMissions[labMissionId];
  const correctN = labOutcomes.filter(o=>mission.event(o)).length;
  const correctP = correctN / labOutcomes.length;
  const countCorrect = Number.isInteger(nAnswer) && nAnswer === correctN;
  const probabilityCorrect = Number.isFinite(pAnswer) && Math.abs(pAnswer - correctP) < 0.0001;
  if(countCorrect && probabilityCorrect){
    labFeedback.textContent = "Benar! Jawabanmu tepat.";
    labFeedback.style.color = "#15803d";
  }else{
    labFeedback.textContent = "Jawaban belum tepat. Periksa kembali banyak anggota kejadian dan peluang teoretisnya.";
    labFeedback.style.color = "#b91c1c";
  }
}

document.getElementById("rollNext").addEventListener("click", labRollNext);
document.getElementById("resetButton").addEventListener("click", labResetMission);
document.getElementById("checkButton").addEventListener("click", labCheckAnswers);
labPreviousButton.addEventListener("click", ()=>{ labNavigateMission(labMissionId - 1); });
labNextButton.addEventListener("click", ()=>{ labNavigateMission(labMissionId + 1); });
labMissionSelect.addEventListener("change", ()=>{ if(labRollingKeys.size === 0){ labSetupMission(); } });


