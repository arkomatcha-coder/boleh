$("m4ProbabilityCalculate").addEventListener("click",()=>{
  const rawA = $("m4PA").value.trim();
  const rawB = $("m4PB").value.trim();
  const rawAB = $("m4PAB").value.trim();
  const pa = Number(rawA);
  const pb = Number(rawB);
  const pab = Number(rawAB);

  if(
    rawA === "" ||
    rawB === "" ||
    rawAB === "" ||
    !Number.isFinite(pa) ||
    !Number.isFinite(pb) ||
    !Number.isFinite(pab)
  ){
    showResult(
      "m4ProbabilityResult",
      "<strong>Periksa kembali data.</strong><p>Lengkapi semua nilai peluang terlebih dahulu.</p>"
    );
    return;
  }

  if(
    pa < 0 || pa > 1 ||
    pb < 0 || pb > 1 ||
    pab < 0 || pab > 1
  ){
    showResult(
      "m4ProbabilityResult",
      "<strong>Nilai tidak valid.</strong><p>Setiap peluang harus berada antara 0 dan 1.</p>"
    );
    return;
  }

  if(
    pab > pa ||
    pab > pb ||
    pa+pb-pab > 1
  ){
    showResult(
      "m4ProbabilityResult",
      "<strong>Data peluang tidak memenuhi aturan.</strong><p>Periksa kembali nilai P(A), P(B), dan P(A ∩ B).</p>"
    );
    return;
  }

  const resultA = pb > 0 ? pab/pb : null;
  const resultB = pa > 0 ? pab/pa : null;

  showResult("m4ProbabilityResult",`
    <h3>Hasil Perhitungan</h3>
    <p><strong>Peluang A dengan syarat B:</strong></p>
    <div class="math">
      P(A|B) = P(A ∩ B) / P(B)
    </div>
    ${
      resultA !== null
      ? `
        <div class="math">
          P(A|B) = ${pab} / ${pb} =
          ${resultA.toLocaleString("id-ID",{maximumFractionDigits:4})}
        </div>
        <p><strong>${decimal(resultA)}</strong></p>
      `
      : `
        <p>P(A|B) tidak terdefinisi karena P(B) = 0.</p>
      `
    }
    <hr>
    <p><strong>Peluang B dengan syarat A:</strong></p>
    <div class="math">
      P(B|A) = P(A ∩ B) / P(A)
    </div>
    ${
      resultB !== null
      ? `
        <div class="math">
          P(B|A) = ${pab} / ${pa} =
          ${resultB.toLocaleString("id-ID",{maximumFractionDigits:4})}
        </div>
        <p><strong>${decimal(resultB)}</strong></p>
      `
      : `
        <p>P(B|A) tidak terdefinisi karena P(A) = 0.</p>
      `
    }
  `);

  markTopicComplete("m4");
});

