  if(a+b > total){
    showResult(
      "m1Result",
      "<strong>Angka belum sesuai.</strong><p>Jumlah kupon buku dan tumbler tidak boleh melebihi jumlah seluruh kupon.</p>"
    );
    return;
  }

  const union = (a+b)/total;

  showResult("m1Result",`
    <h3>Langkah penyelesaian</h3>
    <p>n(S) = ${total}, n(A) = ${a}, dan n(B) = ${b}.</p>
    <div class="math">
      P(A) = a/{total} = ${decimal(a/total)}
    </div>
    <div class="math">
      P(B) = b/{total} = ${decimal(b/total)}
    </div>
    <div class="math">P(A ∩ B) = 0</div>
    <div class="math">
      P(A ∪ B) = P(A) + P(B)
    </div>
    <div class="math">
      P(A ∪ B) = a/{total} + b/{total} = ${fraction(a+b,total)}
    </div>
    <p>
      <strong>
        Jadi, peluang mendapatkan buku atau tumbler adalah
        ${fraction(a+b,total)} atau ${decimal(union)}.
      </strong>
    </p>
  `);

  markTopicComplete("m1");
});

