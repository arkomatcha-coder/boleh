const indCoin = $("indCoin");
const indDie = $("indDie");
let indTrials = 0;
let indHeads = 0;
let indSix = 0;
let indBoth = 0;
let indBusy = false;
let indHistory = [];

function createDieFaces(cube){
  cube.innerHTML = "";
  const sides = [["front",1],["back",6],["right",3],["left",4],["top",2],["bottom",5]];
  sides.forEach(([side,n])=>{
    const face = document.createElement("div");
    face.className = "face " + side;
    face.dataset.n = n;
    for(let i=0;i<n;i++){
      const pip = document.createElement("span");
      pip.className = "pip";
      face.appendChild(pip);
    }
    cube.appendChild(face);
  });
}

function setDieFace(cube,n){
  const rotations = {1:[0,0],2:[-90,0],3:[0,-90],4:[0,90],5:[90,0],6:[0,180]};
  const [x,y] = rotations[n];
  cube.classList.remove("rolling");
  cube.style.transform = `scale(.76) rotateX(xdeg)rotateY({y}deg)`;
}

function rollDie(cube,n,duration=800){
  return new Promise(resolve=>{
    const rotations = {1:[0,0],2:[-90,0],3:[0,-90],4:[0,90],5:[90,0],6:[0,180]};
    const [x,y] = rotations[n];
    cube.classList.remove("rolling");
    void cube.offsetWidth;
    cube.style.setProperty("--end-x",`${x}deg`);
    cube.style.setProperty("--end-y",`${y}deg`);
    cube.classList.add("rolling");
    setTimeout(()=>{ cube.classList.remove("rolling"); setDieFace(cube,n); resolve(); },duration);
  });
}

createDieFaces(indDie);
setDieFace(indDie,1);

function updateIndependent(){
  $("indTotal").textContent = indTrials;
  $("indCoinCount").textContent = indHeads;
  $("indDieCount").textContent = indSix;
  $("indBothCount").textContent = indBoth;
  const frequency = indTrials ? indBoth/indTrials*100 : 0;
  $("indFrequency").textContent = "Frekuensi relatif kejadian bersama: " + frequency.toLocaleString("id-ID",{maximumFractionDigits:2}) + "%";
  $("indHistory").innerHTML = indHistory.length
    ? indHistory.map((x,i)=>`<span class="independent-chip x.both?"both":""">{i+1}. ${x.coin==="G"?"Gambar":"Angka"}, dadu x.die{x.both?" ✓":""}</span>`).join("")
    : "Belum ada percobaan.";
}

function independentTrial(times){
  if(indBusy) return;
  indBusy = true;
  ["indOnce","indTen","indReset"].forEach(id=>{ $(id).disabled = true; });
  let done = 0;
  function next(){
    const coin = Math.random() < .5 ? "A" : "G";
    const die = 1 + Math.floor(Math.random()*6);
    const both = coin === "G" && die === 6;
    indCoin.classList.remove("flipping");
    void indCoin.offsetWidth;
    indCoin.classList.add("flipping");
    rollDie(indDie,die,times===1?800:300).then(()=>{
      indCoin.classList.remove("flipping");
      indCoin.style.transform = coin === "G" ? "rotateY(180deg)" : "rotateY(0deg)";
      indTrials++;
      if(coin === "G") indHeads++;
      if(die === 6) indSix++;
      if(both) indBoth++;
      indHistory.push({coin,die,both});
      updateIndependent();
      $("indResult").textContent = `Percobaan ${indTrials}: Koin ${coin==="G"?"Gambar":"Angka"}, dadu ${die}.` + (both ? " Kedua kejadian terjadi!" : "");
      done++;
      if(done < times){ setTimeout(next,120); }
      else{ indBusy = false; ["indOnce","indTen","indReset"].forEach(id=>{ $(id).disabled = false; }); }
    });
  }
  next();
}

$("indOnce").addEventListener("click",()=>{ independentTrial(1); });
$("indTen").addEventListener("click",()=>{ independentTrial(10); });
$("indReset").addEventListener("click",()=>{
  if(indBusy) return;
  indTrials = 0; indHeads = 0; indSix = 0; indBoth = 0; indHistory = [];
  $("indResult").textContent = "Koin dan dadu siap dilempar.";
  indCoin.style.transform = "rotateY(0deg)";
  setDieFace(indDie,1);
  updateIndependent();
});

