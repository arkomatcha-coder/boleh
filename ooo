$('modal').addEventListener('click',e=>{
if(e.target===$('modal'))closeModal();
});

function errText(e){
const errors={
'auth/invalid-credential':'Email atau kata sandi salah.',
'auth/email-already-in-use':'Email sudah terdaftar.',
'auth/weak-password':'Kata sandi minimal 6 karakter.',
'auth/invalid-email':'Format email tidak valid.',
'permission-denied':'Akses ditolak. Periksa Firestore Rules.'
};
return errors[e.code]||e.message||'Terjadi kesalahan.';
}

async function getProfile(u){
const r=doc(db,'users',u.uid);
const s=await getDoc(r);

if(s.exists())return s.data();

if((u.email||'').toLowerCase()===ADMIN_EMAIL.toLowerCase()){
const p={
nama:'Admin ADALUANG',
email:u.email,
role:'admin',
status:'approved',
createdAt:serverTimestamp()
};
await setDoc(r,p);
return p;
}
return null;
}

$('form').addEventListener('submit',async e=>{
e.preventDefault();
$('submit').disabled=true;

try{
if(mode==='register'){
const nama=$('name').value.trim();
const email=$('email').value.trim().toLowerCase();
const password=$('password').value;

if(!nama)throw Error('Nama wajib diisi.');
if(email===ADMIN_EMAIL.toLowerCase())throw Error('Email admin tidak bisa digunakan untuk pendaftaran guru.');

const c=await createUserWithEmailAndPassword(auth,email,password);

await setDoc(doc(db,'users',c.user.uid),{
nama,email,role:'guru',status:'pending',createdAt:serverTimestamp()
});

await signOut(auth);
say('Pendaftaran berhasil. Tunggu persetujuan admin.',true);
return;
}

if(mode==='student'){
const nama=$('name').value.trim();
const kode=$('code').value.trim().toUpperCase();

if(!nama||!kode)throw Error('Nama dan kode kelas wajib diisi.');

const s=await getDocs(collection(db,'classes'));
const d=s.docs.find(x=>(x.data().kode||'').toUpperCase()===kode);

if(!d)throw Error('Kode kelas tidak ditemukan. Periksa kembali kode dari guru.');

student={nama,kode,id:d.id,data:d.data()};
closeModal();
renderStudent();
return;
}

await signInWithEmailAndPassword(
auth,
$('email').value.trim().toLowerCase(),
$('password').value
);

closeModal();

}catch(e){
say(errText(e));
}finally{
$('submit').disabled=false;
}
});

onAuthStateChanged(auth,async u=>{
if(!u){
profile=null;
return;
}

try{
let p=await getProfile(u);

if(!p){
await signOut(auth);
alert('Profil akun tidak ditemukan. Daftar akun guru terlebih dahulu.');
return;
}

if(u.email.toLowerCase()===ADMIN_EMAIL.toLowerCase()&&p.role!=='admin'){
await updateDoc(doc(db,'users',u.uid),{role:'admin',status:'approved'});
p.role='admin';
p.status='approved';
}

if(p.role==='guru'&&p.status!=='approved'){
await signOut(auth);
alert(p.status==='rejected'?'Akun guru ditolak admin.':'Akun guru masih menunggu persetujuan admin.');
return;
}

if(!['admin','guru'].includes(p.role)){
await signOut(auth);
alert('Peran akun tidak valid.');
return;
}

profile={...p,uid:u.uid,email:u.email};
student=null;
showDashboard();

}catch(e){
alert(errText(e));
await signOut(auth);
}
});

function showShell(label){
$('landing').style.display='none';
$('app').classList.add('show');
$('userLine').textContent=label;
}

function showDashboard(){
showShell((profile.nama||profile.email)+' · '+(profile.role==='admin'?'Admin':'Guru'));
if(profile.role==='admin')adminDashboard();
else teacherDashboard();
}

window.logout=async()=>{
if(auth.currentUser)await signOut(auth);
profile=null;
student=null;
$('app').classList.remove('show');
$('landing').style.display='block';
};

function item(title,body){
return `<article class="item"><h3>esc(title||'Kelas')</h3>{body}</article>`;
}

