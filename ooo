password:'passBox',
code:'codeBox'
})){
$(id).classList.toggle('hidden',!fields.includes(k));
$(k).required=fields.includes(k);
}

$('modal').classList.add('show');
}

window.closeModal=()=>$('modal').classList.remove('show');

