    <div class="table-wrap">
      <table>
        <thead><tr><th>Dadu 1 \ Dadu 2</th><th>1</th><th>2</th><th>3</th><th>4</th><th>5</th><th>6</th></tr></thead>
        <tbody id="sampleTableBody"></tbody>
      </table>
    </div>
    <div class="result">Banyak anggota ruang sampel dari pelemparan dua dadu adalah <strong>36 kemungkinan hasil</strong>.</div>
