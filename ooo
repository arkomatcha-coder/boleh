  ){
    showResult(
      "m4Result",
      "<strong>Periksa kembali angka.</strong><p>Isi semua kolom dengan bilangan bulat yang valid.</p>"
    );
    return;
  }

  if(
    a > total ||
    b > total ||
    intersection > Math.min(a,b) ||
    a+b-intersection > total
  ){
    showResult(
      "m4Result",
      "<strong>Data belum sesuai.</strong><p>Jumlah anggota masing-masing ekstrakurikuler tidak boleh melebihi jumlah seluruh siswa. Jumlah yang mengikuti keduanya tidak boleh melebihi jumlah A maupun B.</p>"
    );
    return;
  }

  if(a === 0 || b === 0){
    showResult(
      "m4Result",
      `<strong>Salah satu peluang bersyarat tidak terdefinisi.</strong>
      <p>
      ${a===0?"P(A) = 0 sehingga P(B|A) tidak terdefinisi.":""}
      ${b===0?"P(B) = 0 sehingga P(A|B) tidak terdefinisi.":""}
      </p>`
    );
    return;
  }

  const pA = a/total;
  const pB = b/total;
  const pI = intersection/total;
  const conditionalA = intersection/b;
  const conditionalB = intersection/a;

  showResult("m4Result",`
    <h3>Langkah Penyelesaian</h3>
    <p><strong>Diketahui:</strong></p>
    <div class="math">n(S) = ${total}</div>
    <div class="math">n(A) = ${a}</div>
    <div class="math">n(B) = ${b}</div>
    <div class="math">n(A ∩ B) = ${intersection}</div>
    <hr>
    <h3>A. Peluang A dengan syarat B terjadi</h3>
    <p>Ditanyakan P(A|B).</p>
    <div class="math">
      P(B) = b/{total} = ${decimal(pB)}
    </div>
    <div class="math">
      P(A ∩ B) = intersection/{total} = ${decimal(pI)}
    </div>
    <div class="math">
      P(A|B) = P(A ∩ B) / P(B)
    </div>
    <div class="math">
      P(A|B) = (intersection/{total}) / (b/{total})
    </div>
    <div class="math">
      P(A|B) = intersection/{b} = ${fraction(intersection,b)}
    </div>
    <p>
      <strong>
        Jadi, peluang mengikuti sains jika diketahui mengikuti matematika
        adalah ${fraction(intersection,b)} atau ${decimal(conditionalA)}.
      </strong>
    </p>
    <hr>
    <h3>B. Peluang B dengan syarat A terjadi</h3>
    <p>Ditanyakan P(B|A).</p>
    <div class="math">
      P(A) = a/{total} = ${decimal(pA)}
    </div>
    <div class="math">
      P(B|A) = P(A ∩ B) / P(A)
    </div>
    <div class="math">
      P(B|A) = (intersection/{total}) / (a/{total})
    </div>
    <div class="math">
      P(B|A) = intersection/{a} = ${fraction(intersection,a)}
    </div>
    <p>
      <strong>
        Jadi, peluang mengikuti matematika jika diketahui mengikuti sains
        adalah ${fraction(intersection,a)} atau ${decimal(conditionalB)}.
      </strong>
    </p>
  `);

  markTopicComplete("m4");
});


