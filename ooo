      ${b===0?"P(B) = 0 sehingga P(A|B) tidak terdefinisi.":""}
      </p>`
    );
    return;
  }

  const pA = a/total;
  const pB = b/total;
  const pI = intersection/total;
  const conditionalA = intersection/b;
  const conditionalB = intersection/a;

