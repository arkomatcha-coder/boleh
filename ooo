async function adminDashboard(){
$('content').innerHTML=`
<section class="panel">
<h2>Dashboard Admin</h2>
<p class="muted">Kelola pendaftaran guru, pantau status akun, dan kelola kelas ADALUANG.</p>

<div id="adminStats" class="stats">
<div class="empty">Memuat statistik...</div>
</div>

<div class="tabs">
<button type="button" onclick="adminTab('guru')">Manajemen Guru</button>
<button type="button" onclick="adminTab('kelas')">Manajemen Kelas</button>
</div>

<div id="adminSection"></div>
</section>`;

try{
const us=await getDocs(collection(db,'users'));
const cs=await getDocs(collection(db,'classes'));

const teachers=us.docs.map(d=>d.data()).filter(x=>x.role==='guru');

const total=teachers.length;
const active=teachers.filter(x=>x.status==='approved').length;
const pending=teachers.filter(x=>x.status==='pending').length;
const rejected=teachers.filter(x=>x.status==='rejected').length;

$('adminStats').innerHTML=`
<div class="stat"><strong>${total}</strong><span>Total Guru</span></div>
<div class="stat"><strong>${active}</strong><span>Guru Aktif</span></div>
<div class="stat"><strong>${pending}</strong><span>Menunggu Persetujuan</span></div>
<div class="stat"><strong>${rejected}</strong><span>Guru Ditolak</span></div>
<div class="stat"><strong>${cs.size}</strong><span>Total Kelas</span></div>`;

await adminTab('guru');

}catch(e){
$('adminStats').innerHTML=`<div class="empty">Gagal memuat statistik: ${esc(errText(e))}</div>`;
$('adminSection').innerHTML=`<div class="empty">Periksa izin akses Firestore lalu muat ulang halaman.</div>`;
}
}

window.adminTab=async tab=>{
const el=$('adminSection');
el.innerHTML='<div class="empty">Memuat…</div>';

try{
if(tab==='guru'){
const s=await getDocs(collection(db,'users'));
const ts=s.docs.map(d=>({id:d.id,...d.data()})).filter(x=>x.role==='guru');

el.innerHTML=ts.length
?`<div class="items">${ts.map(t=>item(t.nama,`
<p class="muted">${esc(t.email)}</p>
<span class="tag esc(t.status)">{esc(t.status)}</span>
<div class="actions">
${t.status!=='approved'?`<button type="button" class="small-btn" onclick="setStatus('${t.id}','approved')">Terima</button>`:''}
${t.status!=='rejected'?`<button type="button" class="danger" onclick="setStatus('${t.id}','rejected')">Tolak</button>`:''}
</div>
`)).join('')}</div>`
:'<div class="empty">Belum ada akun guru.</div>';

}else{
const s=await getDocs(collection(db,'classes'));

el.innerHTML=s.size
?`<div class="items">${s.docs.map(d=>item(d.data().nama,`
<p class="muted">${esc(d.data().ownerEmail)}</p>
<div class="code">${esc(d.data().kode)}</div>
<div class="actions">
<button type="button" class="danger" onclick="deleteClass('${d.id}')">Hapus kelas</button>
</div>
`)).join('')}</div>`
:'<div class="empty">Belum ada kelas.</div>';
}

}catch(e){
el.innerHTML=`<div class="empty">${esc(errText(e))}</div>`;
}
};

window.setStatus=async(id,status)=>{
try{
await updateDoc(doc(db,'users',id),{status});
await adminTab('guru');
}catch(e){
alert(errText(e));
}
};

window.deleteClass=async id=>{
if(!confirm('Hapus kelas ini?'))return;

try{
await deleteDoc(doc(db,'classes',id));
await adminTab('kelas');
}catch(e){
alert(errText(e));
}
};

